import numpy as np
from scipy.linalg import lu_factor, lu_solve

A = np.array([
    [1.19, 2.11, -100, 1],
    [14.2, -0.112, 12.2, -1],
    [0, 100, -99.9, 1],
    [15.3, 0.110, -13.1, -1]
])

b = np.array([1.12, 3.44, 2.15, 4.16])

lu, piv = lu_factor(A)
x = lu_solve((lu, piv), b)

print("解為 x =", x)
